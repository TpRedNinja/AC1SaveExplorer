<Application x:Class="AC1SaveExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark.xaml here is just the compile-time default so the XAML compiler can resolve every
         {DynamicResource ...} used elsewhere. App.xaml.cs's OnStartup swaps this dictionary's
         contents to whatever theme is actually saved, before MainWindow is created — and can swap
         it again live at runtime (that's the whole point of DynamicResource: no restart needed). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
