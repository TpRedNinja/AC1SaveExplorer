<Window x:Class="AC1SaveExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC1SaveExplorer"
        Title="AC1 Save Object Explorer" Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,20,18,24">

                    <TextBlock Text="AC1 · SAVE FORMAT" Foreground="{StaticResource Accent}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold"/>
                    <TextBlock Text="Save Object Explorer" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12"
                               Text="Load an AC1SaveTool-style dump, sort every object into Save File / Mission / Uncategorized, and grow the hash dictionary as you go."/>

                    <!-- dump panel -->
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="1 · SAVE DUMP" Style="{StaticResource PanelHeader}"/>
                            <Button Content="Load dump.json" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Click="BtnLoadDump_Click"/>
                            <TextBlock x:Name="DumpStatus" Margin="0,8,0,0" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- hash dictionaries panel -->
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="2 · HASH DICTIONARIES" Style="{StaticResource PanelHeader}"/>
                            <UniformGrid Columns="1" Rows="4">
                                <Button Content="Load property hashes…" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="BtnLoadProps_Click"/>
                                <Button Content="Load object names…" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="BtnLoadClasses_Click"/>
                                <Button Content="Export property hashes…" Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="BtnExportProps_Click"/>
                                <Button Content="Export object names…" HorizontalAlignment="Stretch" Click="BtnExportClasses_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="HashStatus" Margin="0,8,0,0" FontSize="11.5"
                                       Foreground="{StaticResource MissionCol}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- breakdown -->
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="BREAKDOWN" Style="{StaticResource PanelHeader}"/>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SaveCol}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save File" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                                <TextBlock x:Name="CountSave" Grid.Column="1" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MissionCol}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mission" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                                <TextBlock x:Name="CountMission" Grid.Column="1" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource UncatCol}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Uncategorized" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                                <TextBlock x:Name="CountUncat" Grid.Column="1" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Candidates" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                                <TextBlock x:Name="CountCandidates" Grid.Column="1" FontFamily="{StaticResource MonoFont}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- legend -->
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="HOW SORTING WORKS" Style="{StaticResource PanelHeader}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                       Text="Save = low, non-hash-looking classIDs or anything you've named into this bucket. Mission = anything you've matched to a MissionItemList / world hash. Uncategorized = everything else. Candidates = objects with the exact same 3-property shape as a confirmed mission (MissionStatus/IsCompleted/Unknown) that you haven't named yet — work this list against ACViewer and hit Save to move each one into Mission. Name any object or property inline to move it and grow the dictionary — changes autosave next to the app."/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= main ================= -->
        <Grid Grid.Column="1" Margin="26,20,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderCol}"
                        BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSave" Style="{StaticResource TabButton}" Content="Save File"
                                     GroupName="tabs" IsChecked="True" Checked="Tab_Checked" Tag="save"/>
                        <RadioButton x:Name="TabMission" Style="{StaticResource TabButton}" Content="Mission"
                                     GroupName="tabs" Checked="Tab_Checked" Tag="mission"/>
                        <RadioButton x:Name="TabUncat" Style="{StaticResource TabButton}" Content="Uncategorized"
                                     GroupName="tabs" Checked="Tab_Checked" Tag="uncategorized"/>
                        <RadioButton x:Name="TabCandidates" Style="{StaticResource TabButton}" Content="Candidates"
                                     GroupName="tabs" Checked="Tab_Checked" Tag="candidates"/>
                    </StackPanel>
                </Border>
                <TextBox Grid.Column="1" x:Name="SearchBox" Margin="14,0,0,0" MaxWidth="340"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Tag="Filter by hash, name or property…" TextChanged="SearchBox_TextChanged"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ObjectList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SaveObjectVm}">
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid Margin="4,2,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource AccentBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding HashHex}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource AccentStrong}" FontSize="12"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="Copy hex" FontSize="10.5" Padding="7,2" Margin="0,0,10,0"
                                                Click="CopyHash_Click" Tag="{Binding}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnnamed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Text="{Binding FieldCount, StringFormat={}{0} fields}"/>
                                        <Border Grid.Column="4" CornerRadius="4" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="save">
                                                            <Setter Property="Background" Value="{StaticResource SaveBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="mission">
                                                            <Setter Property="Background" Value="{StaticResource MissionBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="uncategorized">
                                                            <Setter Property="Background" Value="{StaticResource UncatBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="save">
                                                                <Setter Property="Foreground" Value="{StaticResource SaveCol}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="mission">
                                                                <Setter Property="Foreground" Value="{StaticResource MissionCol}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Category}" Value="uncategorized">
                                                                <Setter Property="Foreground" Value="{StaticResource UncatCol}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <Border Background="{StaticResource Surface2}" Padding="16,12,12,14"
                                        BorderBrush="{StaticResource BorderCol}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBox Width="240" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Name this object…"/>
                                            <ComboBox Width="130" Margin="8,0,0,0" SelectedValue="{Binding Category, Mode=TwoWay}"
                                                      SelectedValuePath="Content">
                                                <ComboBoxItem Content="save"/>
                                                <ComboBoxItem Content="mission"/>
                                                <ComboBoxItem Content="uncategorized"/>
                                            </ComboBox>
                                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                    Click="SaveObjectName_Click" Tag="{Binding}"/>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                                       Foreground="{StaticResource TextFaint}"
                                                       Text="{Binding ClassID, StringFormat=classID {0}}"/>
                                        </StackPanel>

                                        <DataGrid ItemsSource="{Binding Rows}" MaxHeight="360">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PROPERTY" Binding="{Binding DisplayName}" Width="2*"/>
                                                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="1*"/>
                                                <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
